{
  "name": "joetjen/cooper-symfony",
  "description": "Symfony integration of Cooper: bundle configuration and container parameters from a CASC document, ${NAME} kept a runtime %env()% placeholder, .env files read by Cooper.",
  "keywords": ["casc", "cooper", "config", "configuration", "symfony", "bundle"],
  "type": "symfony-bundle",
  "homepage": "http://github.com/joetjen/php-cooper-symfony",
  "minimum-stability": "stable",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Jan Oetjen",
      "email": "joetjen.riveting388@passmail.net"
    }
  ],
  "support": {
    "issues": "http://github.com/joetjen/php-cooper-symfony/issues"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../php-cooper-config",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../php-cooper",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.2",
    "joetjen/cooper": "dev-main",
    "joetjen/cooper-config": "dev-main",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/runtime": "^6.4 || ^7.0 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "JOetjen\\CooperSymfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JOetjen\\CooperSymfony\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "analyse": "phpstan analyse --level=8",
    "precommit": ["@analyse", "@test"],
    "docs": "docker run --rm -v $(pwd):/data phpdoc/phpdoc:3"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": false
    }
  }
}
